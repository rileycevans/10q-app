#!/usr/bin/env bash
#
# Puts `friday` on your PATH. Run once, per machine.
#
#   ./tools/friday/install
#
# It creates a symlink, so it never copies a binary and never goes stale:
# after this, `git pull` is the entire update mechanism.
set -euo pipefail

here="$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
target="$here/friday"

# Prefer a directory already on PATH that we can write to without sudo.
dest=""
for candidate in /opt/homebrew/bin /usr/local/bin "$HOME/.local/bin"; do
  if [ -d "$candidate" ] && [ -w "$candidate" ]; then dest="$candidate"; break; fi
done

if [ -z "$dest" ]; then
  dest="$HOME/.local/bin"
  mkdir -p "$dest"
fi

link="$dest/friday"

if [ -e "$link" ] && [ ! -L "$link" ]; then
  echo "install: $link already exists and is not a symlink." >&2
  echo "         Move it aside first — refusing to overwrite a real file." >&2
  exit 1
fi

ln -sfn "$target" "$link"
echo "friday -> $link"

case ":$PATH:" in
  *":$dest:"*) ;;
  *)
    echo
    echo "$dest is not on your PATH yet. Add this to ~/.zshrc:"
    echo "  export PATH=\"$dest:\$PATH\""
    echo "then open a new terminal."
    ;;
esac

echo
echo "Try it:  friday check"
