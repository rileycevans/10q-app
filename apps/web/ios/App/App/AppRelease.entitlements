<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Universal Links. iOS fetches
	  https://play10q.com/.well-known/apple-app-site-association on install
	  and routes matching URLs to the app instead of Safari.

	  This is only half the setup — the AASA file must be served from that
	  path as application/json. Adding the entitlement without the file just
	  means links keep opening in the browser.
	-->
	<!--
	  Push notifications, RELEASE configuration.

	  'production' is required for TestFlight and App Store builds: those
	  register against the production APNs host, and a token issued under
	  'development' is rejected there. The failure is silent — notifications
	  simply never arrive for anyone who installed from the store.

	  Xcode does NOT rewrite this value on archive. That is a common belief
	  and it is wrong when the key is set explicitly in an entitlements file,
	  as it is here: an archive built from App.entitlements carried
	  'development' all the way into the signed binary, verified with
	  `codesign -d --entitlements`.

	  Debug builds keep App.entitlements and its 'development' value, so
	  running from Xcode still registers against the sandbox.
	-->
	<key>aps-environment</key>
	<string>production</string>

	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:play10q.com</string>
		<string>applinks:www.play10q.com</string>
	</array>
</dict>
</plist>
