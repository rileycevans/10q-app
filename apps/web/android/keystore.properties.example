# Copy to keystore.properties (gitignored) and fill in your own values.
#
# storeFile is relative to apps/web/android/. The keystore itself lives
# outside the repo tree in normal use; the path below assumes it sits at
# the repo root, which is where the generation command puts it.
storeFile=../../../../10q-release.jks
storePassword=YOUR_KEYSTORE_PASSWORD
keyAlias=10q
keyPassword=YOUR_KEY_PASSWORD
