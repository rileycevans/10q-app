{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "../../scripts/release/with-version-env.sh next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "../../scripts/release/with-version-env.sh sh -c \"opennextjs-cloudflare build && opennextjs-cloudflare deploy\"",
    "generate:icons": "node scripts/generate-app-icons.mjs",
    "process:logo": "node scripts/make-logo-transparent.mjs",
    "refine:logo": "node scripts/refine-logo-ink.mjs",
    "build:native": "../../scripts/build-native.sh",
    "test:e2e:export": "playwright test --project=export"
  },
  "dependencies": {
    "@10q/contracts": "*",
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@sentry/nextjs": "^9.41.0",
    "@supabase/auth-js": "^2.103.0",
    "@supabase/functions-js": "^2.103.0",
    "@supabase/postgrest-js": "^2.103.0",
    "@supabase/realtime-js": "^2.103.0",
    "@supabase/storage-js": "^2.103.0",
    "@supabase/supabase-js": "^2.89.0",
    "framer-motion": "^12.38.0",
    "next": "^16.1.6",
    "posthog-js": "^1.360.0",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.17.1",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.1.6",
    "serve": "^14.2.6",
    "sharp": "^0.34.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.0.18",
    "wrangler": "^4.71.0"
  }
