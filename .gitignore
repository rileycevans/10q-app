# Playwright output — regenerated on every run, and now on every CI run too
# since the export project was added. These were tracked, so each test run
# showed up as a spurious diff.
apps/web/playwright-report/
apps/web/test-results/

# Finder/editor duplicates ("page 2.tsx"). Next.js ignores filenames with
# spaces so they never become routes, but they are stale copies that get
# swept into commits by a directory-wide `git add` — which has happened twice.
*\ [0-9].*

# Capacitor native build output. The projects themselves ARE tracked — they
# carry hand-edited config (URL schemes, entitlements) that must be reviewed —
# but their build artifacts and resolved dependencies are not.
# (Capacitor 8 uses Swift Package Manager, so there is no Pods/ directory.)
apps/web/ios/App/build/
apps/web/ios/App/App/public/
apps/web/ios/App/.swiftpm/
apps/web/ios/App/CapApp-SPM/.build/
apps/web/ios/DerivedData/
apps/web/android/.gradle/
apps/web/android/build/
apps/web/android/app/build/
apps/web/android/app/src/main/assets/public/
apps/web/android/local.properties
apps/web/android/.idea/
